{
  "name": "Campaign",
  "type": "object",
  "description": "A persistent D&D-style campaign. The DM is whoever created it (created_by); player_emails lists everyone seated at the table.",
  "properties": {
    "name": { "type": "string", "description": "Campaign title" },
    "description": { "type": "string", "format": "richtext", "description": "Campaign premise / setting summary" },
    "dm_email": { "type": "string", "format": "email", "description": "Email of the Dungeon Master running this campaign" },
    "player_emails": {
      "type": "array",
      "items": { "type": "string", "format": "email" },
      "description": "Emails of players seated at this campaign"
    },
    "status": {
      "type": "string",
      "enum": ["setup", "active", "paused", "completed"],
      "default": "setup",
      "description": "Lifecycle state of the campaign"
    },
    "current_scene": {
      "type": "string",
      "format": "richtext",
      "description": "Short description of where the party currently is / what's happening"
    },
    "world_state": {
      "type": "object",
      "description": "Freeform persistent world data: faction standing, economy, notable past events"
    },
    "turn_notify_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether turn-change automations post notifications to the campaign log"
    },
    "dm_notes": {
      "type": "string",
      "format": "richtext",
      "description": "Private DM scratchpad — plot ideas, reminders. Never shown to players.",
      "rls": {
        "read": { "data.dm_email": "{{user.email}}" },
        "write": { "data.dm_email": "{{user.email}}" }
      }
    },
    "ai_features": {
      "type": "object",
      "description": "Which optional AI features the DM has enabled for this campaign, chosen at setup (and editable later). Absent/missing sub-fields are treated as enabled (true) for backward compatibility with campaigns created before this setting existed.",
      "properties": {
        "encounter_generation": { "type": "boolean", "default": true, "description": "DM: 'Generate encounter with AI'" },
        "npc_dialogue": { "type": "boolean", "default": true, "description": "AI-voiced NPC replies when a player talks to one" },
        "rules_assistant": { "type": "boolean", "default": true, "description": "The private 'Ask about the rules' chat" },
        "action_suggestions": { "type": "boolean", "default": true, "description": "'Suggest' buttons for attack/skill-check numbers" },
        "next_beat_suggestions": { "type": "boolean", "default": true, "description": "DM: 'What should happen next?'" }
      }
    }
  },
  "required": ["name", "dm_email"],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "data.dm_email": "{{user.email}}" },
        { "data.player_emails": "{{user.email}}" }
      ]
    },
    "update": { "data.dm_email": "{{user.email}}" },
    "delete": { "data.dm_email": "{{user.email}}" }
  }
}
